# =====================================================================
# Env produksi — IKUT TER-COMMIT. Dimuat oleh `vite build`, perintah yang
# dijalankan Vercel. Isinya tertanam ke dalam bundel JavaScript publik,
# jadi TIDAK BOLEH memuat rahasia apa pun.
# =====================================================================

# Sumber data AWAL untuk pengunjung yang belum pernah memilih.
#
# "true" (Data Contoh) disengaja. Sebelumnya berkas ini berisi
# VITE_USE_MOCK=false tanpa VITE_API_URL. Akibatnya
# pengunjung pertama mendarat di mode Backend API yang menunjuk ke origin
# Vercel sendiri, dan karena vercel.json mengarahkan semua path ke
# index.html, permintaan /api/v1/... dijawab HTML berstatus 200. Klien gagal
# mem-parsing JSON dan aplikasi tampak rusak tanpa pesan yang menjelaskan
# apa pun. Terbukti dengan memeriksa bundel hasil build tanpa .env.local:
# BASE_URL kosong dan sumber awal terkunci "api".
#
# Dengan "true", deployment langsung bisa dipakai untuk demo. Yang butuh
# backend sungguhan cukup menekan tombol "Sumber Data" — pilihannya tersimpan
# di browser dan tidak akan tertimpa berkas ini.
VITE_USE_MOCK=true

# Alamat backend Go untuk mode Backend API.
#
# Dikosongkan DENGAN SENGAJA: belum ada backend yang dihosting untuk
# deployment ini. Mengisinya dengan nilai salah lebih buruk daripada
# mengosongkannya — kosong membuat mode Backend API gagal di origin yang
# sama, bukan menunjuk ke host yang bukan milik kita.
#
# Saat backend sudah dihosting, isi di sini, atau lebih baik di Environment
# Variables Vercel yang menang atas berkas ini:
#   VITE_API_URL=https://api.domain-anda.com
VITE_API_URL=

# Tidak ada variabel lain di berkas ini, dan itu disengaja.
#
# Seluruh kredensial — Paper.id, BNI VM, database, JWT — hidup di
# backend/.env di sisi server. Tidak satu pun boleh menjadi VITE_*, karena
# Vite menyisipkan nilainya apa adanya ke bundel publik.
