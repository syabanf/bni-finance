# =====================================================================
# BNI Finance System — Environment Variables (frontend)
# Salin ke .env.local lalu isi. UI berjalan di atas data mock secara
# default; set VITE_USE_MOCK=false untuk memakai backend Go.
# =====================================================================

# Sumber data AWAL. "true" = mock in-memory (default), "false" = REST API Go.
#
# Ini hanya nilai awal: begitu aplikasi dibuka, pilihan tersimpan di browser dan
# bisa ditukar lewat tombol "Sumber Data" di halaman Pengaturan atau di bawah
# form login. Mengganti berkas ini tidak memengaruhi browser yang sudah pernah
# memilih.
VITE_USE_MOCK=true

# --- Backend API (dipakai saat VITE_USE_MOCK=false) ---
# Alamat backend Go. Dikosongkan = origin yang sama, berguna bila API
# diproksikan di balik domain yang sama.
VITE_API_URL=http://localhost:8080

# --- Quick sign-in ("Login Cepat") pada deployment demo ---
# Di mock mode tombolnya selalu ada. Di mode API tombol hanya muncul bila
# KEDUA variabel ini diisi.
#
# ⚠️ Nilai VITE_* ikut ter-bundle ke JS publik, jadi kata sandi ini bisa
#    dibaca siapa pun. Pakai HANYA akun demo sekali pakai, bukan admin
#    sungguhan.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Catatan: BNI Visitor Management tidak lagi dipanggil dari browser. Sinkronisasi
# berjalan di server (POST /api/v1/sync) supaya tokennya tidak pernah ter-bundle
# ke JavaScript publik — atur BNI_VM_TOKEN di backend/.env.

# --- Paper.id (integrasi invoice & pembayaran) ---
VITE_PAPER_ID_API_URL=https://api.paper.id/v1
