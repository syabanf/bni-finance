# =====================================================================
# BNI Finance — Backend API (Go)
# Salin ke .env lalu isi. File .env TIDAK boleh di-commit.
# =====================================================================

# Port HTTP server
PORT=8080

# Koneksi Postgres. Untuk Supabase, ambil dari:
#   Project Settings → Database → Connection string → URI
# Gunakan connection pooler (port 6543) bila jaringan Anda IPv4-only.
# ⚠️ Berisi password database — rahasia, jangan pernah di-commit.
DATABASE_URL=postgres://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require

# Origin yang boleh memanggil API (pisahkan dengan koma). "*" mengizinkan semua.
ALLOWED_ORIGINS=http://localhost:5173,https://bni-finance.vercel.app

# Bila diisi, semua route /api/** wajib mengirim header:
#   Authorization: Bearer <API_KEY>
# Dikosongkan = tanpa autentikasi (hanya untuk development lokal).
API_KEY=
