# =====================================================================
# BNI Finance — Backend API (Go)
# Salin ke .env lalu isi. File .env TIDAK boleh di-commit.
# =====================================================================

# --- wajib -------------------------------------------------------------------

# Postgres lokal. Backend memakai satu koneksi tepercaya dan menegakkan
# otorisasi sendiri (JWT + peran), jadi kredensial ini setara akses penuh —
# jangan pernah diekspos ke browser.
DATABASE_URL=postgresql://postgres@localhost:5432/bni_finance_dev

# Kunci penanda tangan token sesi. Minimal 32 karakter.
#   openssl rand -base64 48
JWT_SECRET=ganti-dengan-nilai-acak-minimal-32-karakter

# --- opsional ----------------------------------------------------------------

PORT=8080

# Origin yang boleh memanggil API (pisahkan dengan koma).
# "*" hanya untuk pengembangan lokal.
ALLOWED_ORIGINS=http://localhost:5173

# Masa berlaku token sesi — format durasi Go (30m, 12h, 168h).
TOKEN_TTL=12h

# Penyimpanan bukti pembayaran (pengganti Supabase Storage).
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# Admin pertama, dibuat OTOMATIS hanya saat tabel users masih kosong.
# Setelah admin ada, dua baris ini tidak berpengaruh — hapus saja.
SEED_ADMIN_EMAIL=admin@bnifinance.local
SEED_ADMIN_PASSWORD=ganti-kata-sandi-ini
SEED_ADMIN_NAME=Administrator

# --- Masuk cepat tanpa kata sandi (demo & pengembangan lokal) ----------------
#
# Daftar email dipisah koma yang boleh masuk TANPA kata sandi. Kosong = fitur
# mati sepenuhnya, dan itu bawaannya; /api/v1/auth/quick-login menjawab 404.
#
# Sengaja daftar email, bukan saklar on/off: saklar berarti begitu seseorang
# menyalakannya di produksi, SEMUA akun jadi bisa dimasuki tanpa kata sandi.
# Di sini akun yang boleh harus disebut satu per satu.
#
# Server mencatat peringatan di setiap start selama ini terisi. JANGAN diisi
# di produksi.
AUTH_QUICK_LOGIN=

# --- Metrics Prometheus ------------------------------------------------------
#
# /metrics selalu tersedia. Kosong = terbuka tanpa autentikasi; diisi = setiap
# scrape wajib membawa `Authorization: Bearer <token>`.
#
# Terbuka sebagai bawaan karena endpoint metrik yang tak bisa di-scrape bukan
# hardening melainkan hiasan, dan inventaris route yang ia ungkap memang sudah
# publik lewat /docs. Tidak ada data bisnis di sana — label dibatasi pada pola
# route, method, status, mitra integrasi, arah, dan hasil.
#
# Di produksi: isi ini, atau blokir /metrics di ingress.
METRICS_TOKEN=

# --- BNI Visitor Management (opsional) ---------------------------------------
#
# Sumber data member & chapter untuk POST /api/v1/sync. Token juga bisa disimpan
# di app_settings dengan key 'bni_vm_token' — nilai di sana MENANG, sehingga bisa
# diganti dari halaman Pengaturan tanpa redeploy. Dikosongkan keduanya =
# sinkronisasi membalas 503 dengan pesan yang jelas.
BNI_VM_URL=https://www.bni-vh.com/api/external/v1
BNI_VM_TOKEN=

# --- gateway pembayaran (opsional) -------------------------------------------
#
# Dikosongkan = pembayaran mandiri (Xendit) tidak tersedia; sisa aplikasi tetap
# berjalan normal. Sengaja dibaca dari environment, bukan app_settings, karena
# tabel itu bisa dibaca lewat API.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Berapa panggilan integrasi yang disimpan perekam "blackbox" (di memori).
BLACKBOX_SIZE=200

# --- Paper.id (opsional) -----------------------------------------------------
#
# Dipakai saat Self Payment Mode OFF: menerbitkan invoice = mendorongnya ke
# Paper.id (POST /api/v1/invoices/{id}/send). Kredensial RAHASIA — server-side
# saja, jangan pernah ke VITE_*. Dikosongkan = endpoint /send membalas 503.
#
# PAPER_ID_CALLBACK_TOKEN disematkan pada URL callback yang didaftarkan di
# dashboard Paper.id (…/api/v1/webhooks/paperid?token=<token>), karena webhook
# Paper.id tidak membawa tanda tangan sendiri. Dikosongkan = webhook menolak
# semua callback.
PAPER_ID_BASE_URL=https://open-api.stag-v2.paper.id
PAPER_ID_CLIENT_ID=
PAPER_ID_CLIENT_SECRET=
PAPER_ID_CALLBACK_TOKEN=
