{
  "name": "bni-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BNI Finance System \u2014 invoice & membership payment management for BNI",
  "scripts": {
    "setup": "./scripts/setup-env.sh",
    "dev": "vite",
    "api-collection": "node scripts/build-api-collection.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && node scripts/check-tour-anchors.mjs && node scripts/check-seed-integrity.mjs && node scripts/build-api-collection.mjs --check",
    "build": "node scripts/build-api-collection.mjs && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.439.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vite-plugin-pwa": "^0.20.5"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.0",
      "source-map": "^0.7.6"
    }
  }
}
